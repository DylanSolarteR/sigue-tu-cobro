    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-svg-spinners": "^0.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
